# ── Payload CMS ──────────────────────────────────────────────────────────────
# Kunci rahasia untuk enkripsi sesi & token. Wajib diisi.
# Buat dengan: openssl rand -base64 32
PAYLOAD_SECRET=

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URI = koneksi POOLED (Transaction pooler, port 6543).
#   Dipakai saat aplikasi berjalan. Wajib pooled karena Vercel serverless
#   membuka banyak koneksi singkat.
DATABASE_URI=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# DATABASE_URI_DIRECT = koneksi LANGSUNG (Session pooler / direct, port 5432).
#   Dipakai hanya untuk migrasi skema (payload migrate) karena pgBouncer
#   tidak mendukung perintah DDL tertentu.
DATABASE_URI_DIRECT=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── Aplikasi ─────────────────────────────────────────────────────────────────
# URL dasar situs. Lokal: http://localhost:3000 · Produksi: https://gernastastaka.org
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Supabase Storage (S3) — media unggahan staf ──────────────────────────────
# Supabase Dashboard → Storage → S3 Connection. Bucket "media" harus dibuat
# lebih dulu dan diset Public. Kosongkan semua bila ingin memakai disk lokal
# (hanya untuk pengembangan — TIDAK bisa dipakai di Vercel).
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
